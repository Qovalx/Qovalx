(() => {
  "use strict";

  const root = document.documentElement;
  const body = document.body;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(pointer: fine)");
  let activeOverlay = null;
  let returnFocus = null;

  const focusableSelector = [
    "a[href]",
    "button:not([disabled])",
    "input:not([disabled])",
    "select:not([disabled])",
    "textarea:not([disabled])",
    "[tabindex]:not([tabindex='-1'])",
  ].join(",");

  function openOverlay(id, trigger) {
    const overlay = document.getElementById(id);
    if (!overlay || activeOverlay) return;
    returnFocus = trigger;
    activeOverlay = overlay;
    overlay.hidden = false;
    body.classList.add("overlay-open");
    requestAnimationFrame(() => {
      overlay.classList.add("is-open");
      overlay.querySelector(focusableSelector)?.focus();
    });
  }

  function closeOverlay() {
    if (!activeOverlay) return;
    const closing = activeOverlay;
    closing.classList.remove("is-open");
    body.classList.remove("overlay-open");
    activeOverlay = null;
    window.setTimeout(() => {
      closing.hidden = true;
      returnFocus?.focus();
      returnFocus = null;
    }, reducedMotion.matches ? 0 : 350);
  }

  document.addEventListener("click", (event) => {
    const open = event.target.closest("[data-open-overlay]");
    if (open) {
      openOverlay(open.dataset.openOverlay, open);
      return;
    }
    if (event.target.closest("[data-close-overlay]")) closeOverlay();
  });

  document.addEventListener("keydown", (event) => {
    if (!activeOverlay) return;
    if (event.key === "Escape") {
      event.preventDefault();
      closeOverlay();
      return;
    }
    if (event.key !== "Tab") return;
    const items = [...activeOverlay.querySelectorAll(focusableSelector)].filter((item) => item.offsetParent !== null);
    if (!items.length) return;
    const first = items[0];
    const last = items.at(-1);
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  document.querySelectorAll(".language-grid a").forEach((link) => {
    link.addEventListener("click", () => {
      const destination = new URL(link.href);
      const locale = destination.pathname.split("/").filter(Boolean)[0];
      if (locale) {
        try { localStorage.setItem("qovalx-locale", locale); } catch { /* storage can be disabled */ }
      }
    });
  });

  const header = document.querySelector("[data-header]");
  if (header) {
    let lastScroll = window.scrollY;
    let scheduled = false;
    const updateHeader = () => {
      const current = window.scrollY;
      header.classList.toggle("is-fixed", current > 28);
      const goingDown = current > lastScroll + 5;
      const goingUp = current < lastScroll - 5;
      if (goingDown && current > 420 && !activeOverlay) header.classList.add("is-hidden");
      if (goingUp || current < 120) header.classList.remove("is-hidden");
      lastScroll = current;
      scheduled = false;
    };
    window.addEventListener("scroll", () => {
      if (!scheduled) {
        scheduled = true;
        requestAnimationFrame(updateHeader);
      }
    }, { passive: true });
  }

  const revealItems = document.querySelectorAll(".reveal");
  if (reducedMotion.matches || !("IntersectionObserver" in window)) {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  } else {
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.13, rootMargin: "0px 0px -5%" });
    revealItems.forEach((item) => revealObserver.observe(item));
  }

  document.querySelectorAll("[data-parallax-scene]").forEach((scene) => {
    const globe = scene.querySelector(".globe");
    if (!globe || reducedMotion.matches || !finePointer.matches) return;
    let frame = null;
    scene.addEventListener("pointermove", (event) => {
      if (frame) cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const rect = scene.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width - 0.5) * 22;
        const y = ((event.clientY - rect.top) / rect.height - 0.5) * 16;
        const compact = scene.classList.contains("orbital-visual--compact");
        const bx = compact ? -45 : -45;
        const by = compact ? -46 : -46;
        globe.style.transform = `translate(calc(${bx}% + ${x}px), calc(${by}% + ${y}px)) rotateX(${-y * 0.15}deg) rotateY(${x * 0.15}deg)`;
      });
    }, { passive: true });
    scene.addEventListener("pointerleave", () => {
      globe.style.transform = "";
    });
  });

  const toast = document.querySelector(".preview-toast");
  let toastTimer = null;
  document.querySelectorAll("[data-preview-action]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!toast) return;
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => { toast.hidden = true; }, 4000);
    });
  });

  function initialiseConstellation(canvas) {
    const context = canvas.getContext("2d", { alpha: true });
    if (!context) return;
    const scene = canvas.parentElement;
    const points = [];
    let width = 0;
    let height = 0;
    let active = true;
    let animationFrame = null;
    let lastTime = 0;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      canvas.width = Math.floor(width * ratio);
      canvas.height = Math.floor(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      points.length = 0;
      const count = Math.max(24, Math.min(58, Math.round(width / 16)));
      for (let i = 0; i < count; i += 1) {
        points.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.035,
          vy: (Math.random() - 0.5) * 0.035,
          r: Math.random() * 1.1 + 0.35,
        });
      }
    };

    const draw = (time = 0) => {
      if (!active) return;
      const delta = Math.min(32, time - lastTime || 16);
      lastTime = time;
      context.clearRect(0, 0, width, height);
      context.fillStyle = "rgba(240, 201, 118, .72)";
      points.forEach((point) => {
        if (!reducedMotion.matches) {
          point.x += point.vx * delta;
          point.y += point.vy * delta;
          if (point.x < 0 || point.x > width) point.vx *= -1;
          if (point.y < 0 || point.y > height) point.vy *= -1;
        }
        context.beginPath();
        context.arc(point.x, point.y, point.r, 0, Math.PI * 2);
        context.fill();
      });
      context.lineWidth = 0.55;
      for (let i = 0; i < points.length; i += 1) {
        for (let j = i + 1; j < points.length; j += 1) {
          const dx = points[i].x - points[j].x;
          const dy = points[i].y - points[j].y;
          const distance = Math.hypot(dx, dy);
          if (distance > 125) continue;
          context.strokeStyle = `rgba(215, 163, 71, ${(1 - distance / 125) * 0.2})`;
          context.beginPath();
          context.moveTo(points[i].x, points[i].y);
          context.lineTo(points[j].x, points[j].y);
          context.stroke();
        }
      }
      if (!reducedMotion.matches) animationFrame = requestAnimationFrame(draw);
    };

    resize();
    draw();
    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(canvas);
    if ("IntersectionObserver" in window) {
      const visibilityObserver = new IntersectionObserver(([entry]) => {
        active = entry.isIntersecting;
        if (active && !reducedMotion.matches && !animationFrame) animationFrame = requestAnimationFrame(draw);
        if (!active && animationFrame) {
          cancelAnimationFrame(animationFrame);
          animationFrame = null;
        }
      }, { rootMargin: "200px" });
      visibilityObserver.observe(scene);
    }
  }

  document.querySelectorAll("[data-constellation]").forEach(initialiseConstellation);

  root.classList.add("js-ready");
})();
