/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Fingerprinted assets: a change ships under a new filename, so they are held
# for a year. Scoped by extension rather than written as a bare /assets/* so
# that the i18n rule below is not fighting it — when two rules match one
# request Cloudflare joins their values rather than picking one, and a bare
# /assets/* leaves the JSON with "immutable, max-age=31536000" in front of the
# shorter directive, which is the value that wins. Add a line here when a new
# asset type appears; anything unlisted simply falls back to no Cache-Control.
/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

# Locale strings are content, not fingerprinted assets, so they are editable in
# place: five minutes, then revalidate. No rule above matches .json, so this is
# the only rule that applies here.
/assets/i18n/*
  Cache-Control: public, max-age=300, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# The pages are served at directory URLs, which /*.html does not match — the
# request path is /en/, not /en/index.html. Without these the locale pages
# carry no Cache-Control at all and browsers cache them heuristically, which
# leaves stale markup pointing at assets that may since have been replaced.
#
# The splat covers the locale root and every sub-page under it — /en/,
# /en/pricing/, /ar/professionals/ — which an exact /en/ rule does not reach.
# Do not add the exact rules back alongside these: when two rules match one
# request Cloudflare concatenates their values rather than picking one, so the
# pair emits "max-age=0, must-revalidate, max-age=0, must-revalidate". The
# splat matches an empty remainder on its own. Locale directories hold nothing
# but index.html, so these can only ever match a page, never an asset.
/
  Cache-Control: public, max-age=0, must-revalidate
/ar/*
  Cache-Control: public, max-age=0, must-revalidate
/en/*
  Cache-Control: public, max-age=0, must-revalidate
/ru/*
  Cache-Control: public, max-age=0, must-revalidate
/zh-Hans/*
  Cache-Control: public, max-age=0, must-revalidate
/fr/*
  Cache-Control: public, max-age=0, must-revalidate
/es/*
  Cache-Control: public, max-age=0, must-revalidate
/hi/*
  Cache-Control: public, max-age=0, must-revalidate
